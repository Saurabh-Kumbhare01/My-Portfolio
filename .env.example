# ==============================================================================
# RESEND EMAIL SERVICE CONFIGURATION (https://resend.com)
# ==============================================================================

# 1. Your Resend API Key (Get yours from https://resend.com/api-keys)
# Starts with 're_' - KEEP THIS SECRET, never prefix with VITE_
RESEND_API_KEY=re_your_api_key_here

# 2. Recipient Email Address
# The email where you want to receive messages from visitors
CONTACT_RECIPIENT_EMAIL=kumbharesaurabh279@gmail.com

# 3. Sender Email Address
# - For testing without domain verification, use Resend's free test sender:
#   RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
# - When you verify your custom domain in Resend, update it to your verified domain:
#   RESEND_FROM_EMAIL=Portfolio Contact <contact@yourdomain.com>
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
